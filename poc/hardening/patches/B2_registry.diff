+# Modules that are only safe inside the wasm guest. On the native_venv tier the
+# source runs in a real host subprocess with no sandbox, so importing any of
+# these grants direct process/filesystem/network access.
+_NATIVE_VENV_FORBIDDEN_STDLIB_MODULES = frozenset(
+    """
+    os subprocess ctypes socket importlib multiprocessing signal mmap resource
+    pty fcntl posix nt msvcrt winreg _posixsubprocess sys builtins
+    """.split()
+)
+_REFLECTION_NAMES = frozenset(
+    {"__import__", "eval", "exec", "compile", "globals", "vars"}
+)
+_REFLECTION_ATTRS = frozenset(
+    {"__builtins__", "__globals__", "__subclasses__", "__loader__", "__spec__"}
+)
+
 _DEPENDENCY_IMPORT_ALIASES: dict[str, frozenset[str]] = {
